[Unit]
Description=Recourse proof-job operator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=recourse
Group=recourse
WorkingDirectory=/opt/recourse-operator/current
EnvironmentFile=/etc/recourse/operator-runtime.conf
Environment=RECOURSE_OPERATOR_CONFIG=/etc/recourse/operator.json
# V3 derives a generation/activation-commitment namespace below this state root.
Environment=RECOURSE_OPERATOR_DATA_DIRECTORY=/var/lib/recourse-operator
ExecStart=/usr/bin/node /opt/recourse-operator/current/daemon/operator.mjs
Restart=on-failure
RestartSec=10s
KillSignal=SIGTERM
TimeoutStopSec=90s
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectProc=invisible
ProcSubset=pid
ReadWritePaths=/var/lib/recourse-operator
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
